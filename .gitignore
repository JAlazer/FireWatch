# ---------- Secrets & environment ----------
.env
*.env
.env.*
!.env.example          # keep a template so teammates know what vars are needed

# ---------- Python / FastAPI backend ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
*.db                    # local SQLite files if you use one for quick dev
*.sqlite3

# Alembic — keep the migration scripts, ignore only local artifacts if any
# (versions/ folder itself should be committed, no ignore needed there)

# ---------- Model artifacts ----------
*.pkl
*.joblib
*.h5
*.onnx
/app/ml/models/*.bin    # trained model binaries — these get large fast and shouldn't live in git history
# consider Git LFS or cloud storage (S3, GCS) instead of committing large models directly

# ---------- Node / React Native / Expo frontend ----------
node_modules/
.expo/
.expo-shared/
dist/
web-build/

# Native projects generated by `expo prebuild` — regenerate, don't commit
/ios/
/android/

# Data Parsing
data-parsing/*.xml
data-parsing/*.csv